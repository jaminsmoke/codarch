{
  "name": "codarch",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "analyze": "tsx apps/cli/src/index.ts analyze",
    "inspect": "tsx apps/cli/src/index.ts inspect",
    "render": "tsx apps/cli/src/index.ts render",
    "bench:render": "tsx scripts/bench-render.ts",
    "bench:analyze": "tsx scripts/bench-analyze.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "samples": "node scripts/fetch-samples.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
