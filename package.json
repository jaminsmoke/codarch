{
  "name": "codarch",
  "private": true,
  "version": "0.3.0-alpha.1",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "analyze": "tsx apps/cli/src/index.ts analyze",
    "diff": "tsx apps/cli/src/index.ts diff",
    "inspect": "tsx apps/cli/src/index.ts inspect",
    "render": "tsx apps/cli/src/index.ts render",
    "mcp": "node apps/mcp/bin/codarch-mcp.mjs",
    "bench:render": "tsx scripts/bench-render.ts",
    "bench:analyze": "tsx scripts/bench-analyze.ts",
    "bench:diff": "tsx scripts/bench-diff.ts",
    "build:cli": "node scripts/build-cli.mjs",
    "pack:cli": "npm run web:build && npm run build:cli && node scripts/pack-cli.mjs",
    "publish:cli": "npm run web:build && npm run build:cli && node scripts/publish-cli.mjs",
    "sync:action": "node scripts/sync-action.mjs",
    "docs": "node scripts/docs.mjs",
    "version": "node scripts/version.mjs",
    "web:dev": "npm run dev --workspace @codarch/web",
    "web:build": "npm run build --workspace @codarch/web",
    "web:preview": "npm run preview --workspace @codarch/web",
    "desktop:build": "npm run build --workspace @codarch/desktop",
    "desktop:start": "npm run start --workspace @codarch/desktop",
    "serve": "npm run web:build && tsx apps/cli/src/index.ts serve",
    "check:action": "node scripts/check-action.mjs",
    "icons": "node scripts/make-icons.mjs",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "samples": "node scripts/fetch-samples.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.89.0",
    "three": "^0.180.0",
    "tree-sitter": "0.25.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "tree-sitter": "0.25.1"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "tree-sitter@0.25.1": true,
    "tree-sitter-javascript@0.23.1": true,
    "tree-sitter-typescript@0.23.2": true
  }
}
