---
import GuiaSite from "../components/GuiaSite";
import Site from "../layouts/Site.astro";
import { cargarGuia } from "../lib/guia-carga";
import { resumenDias } from "../lib/guia-servidor";

const datos = await cargarGuia();
const dia = datos.dias.at(-1);
if (!dia) throw new Error("La guía no tiene días");
const dias = resumenDias(datos.dias);
---

<Site
  title="La guía — CodArch"
  description="Lo que se ha pensado y lo que queda: cada día de CodArch como un changelog, con el veredicto de cada idea."
  canonical="https://jaminsmoke.github.io/codarch/guia/"
>
  <GuiaSite
    client:only="react"
    modo="dia"
    dia={dia}
    dias={dias}
    activo={dia.fecha}
    introduccion={datos.introduccion}
  />
</Site>
