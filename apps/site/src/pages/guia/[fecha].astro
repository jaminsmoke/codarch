---
import GuiaApp from "../../components/GuiaApp";
import Site from "../../layouts/Site.astro";
import { fechaPartida } from "../../lib/guia";
import { cargarGuia } from "../../lib/guia-carga";

export async function getStaticPaths() {
  const datos = await cargarGuia();
  return datos.dias.map((dia) => ({
    params: { fecha: dia.fecha },
    props: { fecha: dia.fecha }
  }));
}

const { fecha: clave } = Astro.props;
const datos = await cargarGuia();
const dia = datos.dias.find((d) => d.fecha === clave);
if (!dia) throw new Error(`Día desconocido: ${clave}`);
const fecha = fechaPartida(dia.fecha);
const ultima = datos.dias.at(-1)?.fecha ?? dia.fecha;
const canonical =
  dia.fecha === ultima
    ? "https://jaminsmoke.github.io/codarch/guia/"
    : `https://jaminsmoke.github.io/codarch/guia/${dia.fecha}/`;
---

<Site
  title={`${fecha.dia} de ${fecha.mes} de ${fecha.anio} — La guía — CodArch`}
  description={`Las ideas del ${fecha.dia} de ${fecha.mes} de ${fecha.anio} en la guía de CodArch, con su veredicto.`}
  {canonical}
>
  <GuiaApp client:only="react" datos={datos} lang={Astro.currentLocale ?? "es"} />
</Site>
