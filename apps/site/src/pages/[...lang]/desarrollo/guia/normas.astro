---
import GuideApp from "../../../../components/GuideApp";
import Site from "../../../../layouts/Site.astro";
import { loadGuide } from "../../../../lib/guide-load";
import { localeOf, t } from "../../../../lib/i18n";
import { canonicalUrl } from "../../../../lib/routes";

/** Cómo se escribe la guía: `/desarrollo/guia/normas/` y `/en/desarrollo/guia/normas/`. */
export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: "en" } }];
}

const locale = localeOf(Astro.params.lang);
const datos = await loadGuide(locale);
const canonical = canonicalUrl(
  locale === "en" ? "/en/desarrollo/guia/normas/" : "/desarrollo/guia/normas/"
);
---

<Site
  title={t(locale, "meta.guia.normas.titulo")}
  description={t(locale, "meta.guia.normas.desc")}
  {canonical}
>
  <GuideApp client:only="react" datos={datos} lang={locale} />
</Site>
