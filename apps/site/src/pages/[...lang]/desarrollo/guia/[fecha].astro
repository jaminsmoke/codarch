---
import GuideApp from "../../../../components/GuideApp";
import Site from "../../../../layouts/Site.astro";
import { loadGuide } from "../../../../lib/guide-load";
import { fullDate, dayPath } from "../../../../lib/guide";
import { localeOf, t } from "../../../../lib/i18n";
import { canonicalUrl } from "../../../../lib/routes";

/**
 * Un día de la guía, en los dos idiomas.
 *
 * Las fechas son las mismas en los dos idiomas, así que cada una se genera dos
 * veces: sin prefijo y con `/en`. El texto del día sale de la colección del
 * idioma que toca.
 */
export async function getStaticPaths() {
  const es = await loadGuide("es");
  const en = await loadGuide("en");
  return [
    ...es.days.map((dia) => ({
      params: { lang: undefined, fecha: dia.date }
    })),
    ...en.days.map((dia) => ({
      params: { lang: "en", fecha: dia.date }
    }))
  ];
}

const idioma = localeOf(Astro.params.lang);
const clave = Astro.params.fecha;
const datos = await loadGuide(idioma);
const dia = datos.days.find((d) => d.date === clave);
if (!dia) throw new Error(`Día desconocido: ${clave}`);

const longDate = fullDate(dia.date, idioma);
const titulo = t(idioma, "meta.guia.dia.titulo").replace("{fecha}", longDate);
const descripcion = t(idioma, "meta.guia.dia.desc").replace(
  "{fecha}",
  longDate
);
const ultima = datos.days.at(-1)?.date ?? dia.date;
const canonical = canonicalUrl(dayPath(dia.date, ultima, idioma));
---

<Site title={titulo} description={descripcion} {canonical}>
  <GuideApp client:only="react" datos={datos} lang={idioma} />
</Site>
