---
import GuideApp from "../../../../components/GuideApp";
import Site from "../../../../layouts/Site.astro";
import { loadGuide } from "../../../../lib/guide-load";
import { fullDate, dayPath } from "../../../../lib/guide";
import { localeOf, t } from "../../../../lib/i18n";
import { canonicalUrl } from "../../../../lib/routes";

/**
 * Un día de la guía, en los dos idiomas.
 *
 * Las fechas son las mismas en los dos idiomas, así que cada una se genera dos
 * veces: sin prefijo y con `/en`. El texto del día sale de la colección del
 * idioma que toca.
 */
export async function getStaticPaths() {
  const es = await loadGuide("es");
  const en = await loadGuide("en");
  return [
    ...es.days.map((day) => ({
      params: { lang: undefined, fecha: day.date }
    })),
    ...en.days.map((day) => ({
      params: { lang: "en", fecha: day.date }
    }))
  ];
}

const locale = localeOf(Astro.params.lang);
const key = Astro.params.fecha;
const datos = await loadGuide(locale);
const day = datos.days.find((d) => d.date === key);
if (!day) throw new Error(`Día desconocido: ${key}`);

const longDate = fullDate(day.date, locale);
const titulo = t(locale, "meta.guia.dia.titulo").replace("{fecha}", longDate);
const descripcion = t(locale, "meta.guia.dia.desc").replace(
  "{fecha}",
  longDate
);
const ultima = datos.days.at(-1)?.date ?? day.date;
const canonical = canonicalUrl(dayPath(day.date, ultima, locale));
---

<Site title={titulo} description={descripcion} {canonical}>
  <GuideApp client:only="react" datos={datos} lang={locale} />
</Site>
