---
import GuideApp from "../../../components/GuideApp";
import Site from "../../../layouts/Site.astro";
import { loadGuide } from "../../../lib/guide-load";
import { localeOf, t } from "../../../lib/i18n";
import { canonicalUrl } from "../../../lib/routes";

/** La guía, en los dos idiomas: `/desarrollo/guia/` y `/en/desarrollo/guia/`. */
export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: "en" } }];
}

const locale = localeOf(Astro.params.lang);
const datos = await loadGuide(locale);
const canonical = canonicalUrl(locale === "en" ? "/en/desarrollo/guia/" : "/desarrollo/guia/");
---

<Site
  title={t(locale, "meta.guia.titulo")}
  description={t(locale, "meta.guia.desc")}
  {canonical}
>
  <GuideApp client:only="react" datos={datos} lang={locale} />
</Site>
