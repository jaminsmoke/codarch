---
import GuideApp from "../../../components/GuideApp";
import Site from "../../../layouts/Site.astro";
import { loadGuide } from "../../../lib/guide-load";
import { localeOf, t } from "../../../lib/i18n";
import { canonicalUrl } from "../../../lib/routes";

/** La guía, en los dos idiomas: `/desarrollo/guia/` y `/en/desarrollo/guia/`. */
export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: "en" } }];
}

const idioma = localeOf(Astro.params.lang);
const datos = await loadGuide(idioma);
const canonical = canonicalUrl(idioma === "en" ? "/en/desarrollo/guia/" : "/desarrollo/guia/");
---

<Site
  title={t(idioma, "meta.guia.titulo")}
  description={t(idioma, "meta.guia.desc")}
  {canonical}
>
  <GuideApp client:only="react" datos={datos} lang={idioma} />
</Site>
