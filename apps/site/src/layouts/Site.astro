---
import "../styles.css";
import Barra from "../components/Barra.astro";
import Tema from "../components/Tema.astro";
import { idiomaDe } from "../lib/i18n";
import { CLAVE_TEMA } from "../lib/tema";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = "CodArch — el mapa vivo de la arquitectura de tu software",
  description = "CodArch analiza tu repositorio y lo dibuja: en el pull request, en el CI y en tu agente.",
  canonical
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const idioma = idiomaDe(Astro.currentLocale);
---

<!doctype html>
<html lang={Astro.currentLocale ?? "es"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <Tema />
    {/* El tema se aplica antes de pintar: sin esto se ve un fogonazo claro al
        abrir la página guardada en oscuro. La clave es la de Starlight, así
        que lo elegido en los documentos vale también aquí. */}
    <script is:inline define:vars={{ clave: CLAVE_TEMA }}>
      (() => {
        const guardado = localStorage.getItem(clave);
        const sistema = matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
        document.documentElement.dataset.theme =
          guardado === "light" || guardado === "dark" ? guardado : sistema;
      })();
    </script>
    {canonical ? <link rel="canonical" href={canonical} /> : null}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,650;12..96,750&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <div class="sitio-barra">
      <Barra idioma={idioma} />
    </div>
    <slot />
  </body>
</html>

<style is:global>
  /* La barra se queda arriba; los pies y las islas van debajo. */
  .sitio-barra {
    position: sticky;
    top: 0;
    z-index: 40;
  }
</style>
