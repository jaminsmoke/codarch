---
import { idiomaDe, t } from "../lib/i18n";
import { CLAVE_TEMA } from "../lib/tema";

/**
 * El botón de tema de la cabecera: claro u oscuro, y lo recuerda.
 *
 * No hay «automático» en el botón: sin nada guardado se sigue al sistema, y
 * en cuanto se pulsa queda elegido en `localStorage` —con la clave de
 * Starlight, para que los documentos y las páginas propias no se contradigan—.
 * Los dos iconos están en el marcado y el CSS enseña el que toca, así que el
 * botón no parpadea al cambiar de tema.
 */

const { idioma: lang } = Astro.props as { idioma?: string };
const etiqueta = t(idiomaDe(lang), "marco.tema");
---

<button type="button" class="boton-tema" data-boton-tema title={etiqueta} aria-label={etiqueta}>
  <svg
    class="tema-icono tema-sol"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.9"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4.2" />
    <path d="M12 2.6v2.2M12 19.2v2.2M4.4 4.4l1.6 1.6M18 18l1.6 1.6M2.6 12h2.2M19.2 12h2.2M4.4 19.6 6 18M18 6l1.6-1.6" />
  </svg>
  <svg
    class="tema-icono tema-luna"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.9"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20.4 14.7A8.6 8.6 0 0 1 9.3 3.6a8.6 8.6 0 1 0 11.1 11.1Z" />
  </svg>
</button>

<script>
  import { CLAVE_TEMA } from "../lib/tema";

  const boton = document.querySelector<HTMLButtonElement>("[data-boton-tema]");
  const raiz = document.documentElement;

  boton?.addEventListener("click", () => {
    const siguiente = raiz.dataset.theme === "dark" ? "light" : "dark";
    raiz.dataset.theme = siguiente;
    try {
      localStorage.setItem(CLAVE_TEMA, siguiente);
    } catch {
      // Sin almacenamiento (modo privado) el tema vale para esta página.
    }
  });
</script>

<style>
  .boton-tema {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    padding: 0;
    border: 1px solid var(--barra-linea, #c8d1d5);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--barra-tenue, #55626a);
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .boton-tema:hover {
    color: var(--barra-tinta, #121a20);
    border-color: var(--barra-tenue, #55626a);
  }

  .boton-tema:focus-visible {
    outline: 2px solid var(--barra-acento-suave, #d95d39);
    outline-offset: 2px;
  }

  .tema-icono {
    width: 1rem;
    height: 1rem;
  }

  /* De día, el sol invita a ir a oscuro; de noche, la luna a volver. */
  .tema-luna {
    display: none;
  }

  :global(html[data-theme="dark"]) .tema-sol {
    display: none;
  }

  :global(html[data-theme="dark"]) .tema-luna {
    display: block;
  }
</style>
