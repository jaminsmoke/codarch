---
import MobileMenuToggle from "virtual:starlight/components/MobileMenuToggle";
import Search from "virtual:starlight/components/Search";
import { idiomaDe } from "../lib/i18n";
import Barra from "./Barra.astro";

/**
 * La cabecera de los documentos: la misma que la del resto del sitio.
 *
 * Starlight deja su propio marco —fijo, con la altura que usa para colocar la
 * barra lateral— y aquí solo se le quita el fondo y el relleno para que mande
 * la barra compartida. Lo único que añaden los documentos son el buscador y el
 * botón del menú, y los dos entran en la propia barra: el menú flotaba fuera de
 * ella —fijo, en el borde del marco— y le robaba ancho a la derecha, así que la
 * cabecera no era la misma que en la portada. Dentro, es una pieza más.
 */

const idioma = idiomaDe(
  Astro.locals.starlightRoute?.locale ?? Astro.currentLocale
);
---

<Barra idioma={idioma} ruta={Astro.url.pathname}>
  <Search />
  <MobileMenuToggle slot="menu" />
</Barra>

<style>
  @layer starlight.core {
    /* El marco de Starlight se queda con su alto y su sticky; la pintura y el
       relleno son de la barra. Sin el relleno que le deja hueco al botón del
       menú, porque ese botón ya no flota encima. */
    :global(.page > header.header) {
      padding: 0;
      background: none;
      border-bottom: 0;
      backdrop-filter: none;
    }
  }

  /* El buscador de Starlight pide `width: 100%` y, al compartir fila con el
     idioma y el tema, se comía su ancho: el enlace al repo acababa encogido y
     la cabecera no medía lo mismo que en la portada. Con un ancho propio y el
     resto sin encoger, cada pieza conserva su tamaño. */
  :global(.barra .barra-acciones > *) {
    flex: none;
  }

  @media (min-width: 50rem) {
    :global(.barra .barra-acciones button[data-open-modal]) {
      width: 14rem;
      flex: 0 1 auto;
      min-width: 0;
    }
  }

  /* El menú de Starlight es un botón flotante; aquí es una pieza más de la
     barra, del tamaño del de tema y con el estado abierto dibujado por
     nosotros —su regla depende de un hermano que ya no lo acompaña—. Las
     reglas son globales porque el botón y la barra son de otro componente; el
     prefijo `.barra` las deja en la cabecera y en ningún otro sitio. */
  :global(.barra .sl-menu-button) {
    position: static;
    inset: auto;
    display: none;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    padding: 0.4rem;
    border: 1px solid var(--barra-linea);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--barra-tenue);
    box-shadow: none;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  @media (max-width: 50rem) {
    :global(.barra .sl-menu-button) {
      display: inline-flex;
    }
  }

  :global(.barra .sl-menu-button:hover) {
    color: var(--barra-tinta);
    border-color: var(--barra-tenue);
  }

  :global(.barra .sl-menu-button:focus-visible) {
    outline: 2px solid var(--barra-acento-suave);
    outline-offset: 2px;
  }

  :global(.barra .sl-menu-button .open-menu) {
    display: block;
    width: 100%;
    height: 100%;
  }

  :global(.barra .sl-menu-button .close-menu) {
    display: none;
  }

  :global(body:has(#starlight__sidebar:popover-open) .barra .sl-menu-button .open-menu) {
    display: none;
  }

  :global(body:has(#starlight__sidebar:popover-open) .barra .sl-menu-button .close-menu) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
