---
import DefaultHeader from "@astrojs/starlight/components/Header.astro";

/**
 * La cabecera de los documentos (ADR 0047 · ADR 0081).
 *
 * Starlight pone la búsqueda, el tema y el GitHub; aquí se añaden los enlaces
 * que ya tienen la portada y la guía, para no perder la navegación del sitio.
 */

// Starlight traduce con la colección `i18n` y el idioma de la página.
const t = Astro.locals.t;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const ruta = Astro.url.pathname;
// Los enlaces siguen el idioma de la página.
const raiz = ruta.startsWith(`${base}/en/`) || ruta === `${base}/en`
  ? `${base}/en`
  : base;

/** Inicio · Documentación · Desarrollo (ADR 0081); la guía está en Desarrollo. */
const enlaces = [
  {
    href: `${raiz}/`,
    texto: t("nav.inicio"),
    activo: ruta === `${raiz}/` || ruta === raiz
  },
  {
    href: `${raiz}/docs/`,
    texto: t("nav.documentacion"),
    activo: ruta.startsWith(`${raiz}/docs`)
  },
  {
    href: `${raiz}/desarrollo/`,
    texto: t("nav.desarrollo"),
    activo: ruta.startsWith(`${raiz}/desarrollo`)
  }
];
---

<div class="codarch-header">
  <DefaultHeader />
  <nav class="codarch-nav" aria-label={t("nav.aria")}>
    {
      enlaces.map((enlace) => (
        <a
          href={enlace.href}
          aria-current={enlace.activo ? "page" : undefined}
          class:list={["codarch-nav-enlace", { activo: enlace.activo }]}
        >
          {enlace.texto}
        </a>
      ))
    }
  </nav>
</div>

<style>
  @layer starlight.core {
    .codarch-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      height: 100%;
    }

    .codarch-header :global(.header) {
      flex: 1;
      min-width: 0;
    }

    .codarch-nav {
      display: flex;
      align-items: center;
      gap: 0.15rem;
    }

    .codarch-nav-enlace {
      border-radius: 0.5rem;
      padding: 0.35rem 0.7rem;
      font-size: var(--sl-text-sm);
      color: var(--sl-color-gray-2);
      text-decoration: none;
      white-space: nowrap;
    }

    .codarch-nav-enlace:hover {
      background: var(--sl-color-gray-6);
      color: var(--sl-color-white);
    }

    .codarch-nav-enlace.activo {
      background: var(--sl-color-accent-low);
      color: var(--sl-color-text-accent);
      font-weight: 600;
    }

    @media (max-width: 50rem) {
      .codarch-nav {
        display: none;
      }
    }
  }
</style>
