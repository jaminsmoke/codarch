---
import Default from "@astrojs/starlight/components/MarkdownContent.astro";
import { etiquetaZona } from "../lib/zonas.mjs";

/**
 * El contenido de un documento, con su zona para la búsqueda (ADR 0081):
 * Pagefind ofrece el filtro «zona» con el nombre de la zona en el idioma de la
 * página, y la búsqueda lo aplica por defecto (`Search.astro`).
 */

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const zona = etiquetaZona(Astro.url.pathname.slice(base.length) || "/");
---

<Default>
  {zona && <span hidden data-pagefind-filter="zona">{zona}</span>}
  <slot />
</Default>
