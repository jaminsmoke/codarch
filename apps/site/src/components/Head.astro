---
import DefaultHead from "@astrojs/starlight/components/Head.astro";
import Tema from "./Tema.astro";
---

<Tema />
<DefaultHead />

<script>
  import { pintarDiagramas } from "../lib/mermaid";

  const pintar = (): void => {
    void pintarDiagramas(document.body);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", pintar, { once: true });
  } else {
    pintar();
  }
</script>
