{
  "name": "@codarch/desktop",
  "version": "0.3.4",
  "description": "Mapa de arquitectura para equipos y agentes de IA",
  "homepage": "https://github.com/jaminsmoke/codarch",
  "author": "jaminsmoke",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dev": "npm run build:main && vite",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codarch/metrics": "*",
    "@codarch/parsers": "*",
    "@codarch/render": "*",
    "@codarch/schema": "*",
    "@codarch/ui": "*",
    "@codarch/versions": "*",
    "@radix-ui/react-dialog": "^1.3.1",
    "electron-updater": "^6.7.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4"
  }
}
