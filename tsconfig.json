{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@codarch/schema": ["packages/schema/src/index.ts"],
      "@codarch/schema/browser": ["packages/schema/src/browser.ts"],
      "@codarch/parsers": ["packages/parsers/src/index.ts"],
      "@codarch/parsers/browser": ["packages/parsers/src/browser.ts"],
      "@codarch/parsers/fs": ["packages/parsers/src/fs.ts"],
      "@codarch/layouts": ["packages/layouts/src/index.ts"],
      "@codarch/metrics": ["packages/metrics/src/index.ts"],
      "@codarch/metrics/browser": ["packages/metrics/src/browser.ts"],
      "@codarch/render": ["packages/render/src/index.ts"],
      "@codarch/render/browser": ["packages/render/src/browser.ts"],
      "@codarch/plugin-api": ["packages/plugin-api/src/index.ts"],
      "@codarch/ui": ["packages/ui/src/index.ts"],
      "@codarch/ui/plugins": ["packages/ui/src/plugins.ts"],
      "@codarch/ui/Settings": ["packages/ui/src/Settings.tsx"],
      "@codarch/ui/styles.css": ["packages/ui/src/styles.css"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/test/**/*.ts",
    "plugins/*/src/**/*.ts",
    "plugins/*/src/**/*.tsx",
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "apps/*/test/**/*.ts",
    "apps/*/vite.config.ts",
    "apps/*/vite-server.ts",
    "scripts/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["packages/parsers/test/fixtures/**"]
}
